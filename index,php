<?php
require 'db.php';
session_start();

// Redirect back to login if session profile details are absent
if (!isset($_SESSION['user_id'])) {
    header("Location: login.php");
    exit;
}

$user_id = $_SESSION['user_id'];

// --- FORM PROCESSING LOGIC (CRUD operations) ---

// 1. Check for incoming Income forms
if (isset($_POST['add_income'])) {
    $source = $conn->real_escape_string($_POST['source']);
    $amount = floatval($_POST['amount']);
    $date = $_POST['date'];
    $conn->query("INSERT INTO income (user_id, source, amount, date) VALUES ('$user_id', '$source', '$amount', '$date')");
    header("Location: index.php");
}

// 2. Check for incoming Expense forms
if (isset($_POST['add_expense'])) {
    $title = $conn->real_escape_string($_POST['title']);
    $category = $_POST['category'];
    $amount = floatval($_POST['amount']);
    $date = $_POST['date'];
    $conn->query("INSERT INTO expenses (user_id, title, category, amount, date) VALUES ('$user_id', '$title', '$category', '$amount', '$date')");
    header("Location: index.php");
}

// 3. Process Delete triggers on historical expense logs
if (isset($_GET['delete_expense'])) {
    $id = intval($_GET['delete_expense']);
    $conn->query("DELETE FROM expenses WHERE id=$id AND user_id=$user_id");
    header("Location: index.php");
}

// --- DYNAMIC DATES REPORT SCOPE HANDLER ---
$filter_query = "";
$filter_type = isset($_GET['report_filter']) ? $_GET['report_filter'] : 'all';

if ($filter_type == 'daily') {
    $filter_query = " AND date = CURDATE()";
} elseif ($filter_type == 'weekly') {
    $filter_query = " AND date >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)";
} elseif ($filter_type == 'monthly') {
    $filter_query = " AND MONTH(date) = MONTH(CURDATE()) AND YEAR(date) = YEAR(CURDATE())";
}

// --- CALCULATION LOGIC CALCULATIONS ---
// Get Total Income metrics
$income_res = $conn->query("SELECT SUM(amount) AS total FROM income WHERE user_id=$user_id" . $filter_query);
$total_income = floatval($income_res->fetch_assoc()['total']);

// Get Total Expense metrics
$expense_res = $conn->query("SELECT SUM(amount) AS total FROM expenses WHERE user_id=$user_id" . $filter_query);
$total_expenses = floatval($expense_res->fetch_assoc()['total']);

// Final remaining balance calculation formula
$remaining_balance = $total_income - $total_expenses;

// --- CHART GENERATION COMPILATIONS ---
// Group data sets by category labels for the Pie Chart configuration
$cat_data = [];
$cat_res = $conn->query("SELECT category, SUM(amount) as total FROM expenses WHERE user_id=$user_id GROUP BY category");
while($row = $cat_res->fetch_assoc()) {
    $cat_data[] = array("label" => $row['category'], "y" => floatval($row['total']));
}

// Extract trends based on dates for the Line Graph compilation
$trend_data = [];
$trend_res = $conn->query("SELECT date, SUM(amount) as total FROM expenses WHERE user_id=$user_id GROUP BY date ORDER BY date ASC LIMIT 10");
while($row = $trend_res->fetch_assoc()) {
    $trend_data[] = array("label" => $row['date'], "y" => floatval($row['total']));
}
